{
  "name": "clymly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "e2e": "node scripts/e2e.mjs",
    "ui-check": "node scripts/ui-check.mjs",
    "start:prod": "test -n \"$DATABASE_URL\" || { echo \"Ошибка: не задана переменная DATABASE_URL (строка подключения к PostgreSQL)\" >&2; exit 1; } && prisma db push --skip-generate && tsx prisma/seed.ts && next start -H 0.0.0.0 -p ${PORT:-3000}"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/onest": "^5.3.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "mammoth": "^1.13.0",
    "next": "^15.5.27",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}