generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────── Справочники (профессии и вопросы живут в БД) ─────────

model ProfessionCategory {
  id          String       @id // slug, напр. "it"
  name        String
  sortOrder   Int          @default(0)
  professions Profession[]
}

model Profession {
  id           String             @id // slug, напр. "product-manager"
  name         String
  nameEn       String?
  categoryId   String
  category     ProfessionCategory @relation(fields: [categoryId], references: [id])
  description  String
  skills       String // JSON: string[] — типичные навыки
  requirements String // JSON: string[] — типичные требования
  sortOrder    Int                @default(0)
  active       Boolean            @default(true)

  levelProfiles ProfessionLevelProfile[]
  questions     InterviewQuestion[]
  users         User[]
}

// Junior / Middle / Senior / Lead профили профессии
model ProfessionLevelProfile {
  id           String     @id @default(cuid())
  professionId String
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
  level        String // junior | middle | senior | lead
  summary      String
  expectations String // JSON: string[]
  yearsFrom    Int        @default(0)
  yearsTo      Int?

  @@unique([professionId, level])
}

// Profession → Level → Interview Type → Question
// professionId = null  → вопрос подходит для любой профессии
// level        = null  → вопрос подходит для любого уровня
model InterviewQuestion {
  id           String      @id @default(cuid())
  professionId String?
  profession   Profession? @relation(fields: [professionId], references: [id], onDelete: Cascade)
  level        String?
  type         String // hr | professional | manager
  text         String
  category     String
  difficulty   Int         @default(2) // 1..3
  sampleAnswer String
  keyPoints    String // JSON: string[]
  sortOrder    Int         @default(0)

  attempts PracticeAttempt[]

  @@index([professionId, level, type])
}

// ───────── Пользователи ─────────

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  professionId String?
  profession   Profession? @relation(fields: [professionId], references: [id])
  level        String?
  plan         String      @default("free") // free | pro
  planUntil    DateTime? // до какого момента оплачен pro
  createdAt    DateTime    @default(now())

  sessions  Session[]
  resumes   Resume[]
  vacancies Vacancy[]
  attempts  PracticeAttempt[]
  payments  Payment[]
}

model Session {
  id        String   @id // sha256 токена
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

// ───────── Рабочие данные ─────────

model Resume {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  text         String
  analysis     String // JSON ResumeAnalysis
  professionId String // для какой профессии/уровня сделан анализ
  level        String
  analyzedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  adaptations Adaptation[]

  @@index([userId, createdAt])
}

model Vacancy {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  text       String
  analysis   String // JSON VacancyAnalysis
  matchScore Int
  resumeId   String?
  createdAt  DateTime @default(now())

  adaptation   Adaptation?
  coverLetters CoverLetter[]

  @@index([userId, createdAt])
}

model Adaptation {
  id        String   @id @default(cuid())
  vacancyId String   @unique
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  changes   String // JSON Change[] (id, original, adapted, reason, status, edited?)
  engine    String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model CoverLetter {
  id        String   @id @default(cuid())
  vacancyId String
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  style     String // professional | short | personal
  text      String
  engine    String
  createdAt DateTime @default(now())

  @@index([vacancyId, createdAt])
}

model PracticeAttempt {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String
  score      Int
  feedback   String // JSON AnswerFeedback
  createdAt  DateTime          @default(now())

  @@index([userId, questionId])
}

// ───────── Оплата (ЮKassa; пока работает тестовый провайдер-заглушка) ─────────

model Payment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // stub | yookassa
  providerPaymentId String?  @unique
  planId            String // id тарифа из src/lib/billing/plans.ts
  amount            Int // в копейках
  currency          String   @default("RUB")
  status            String // pending | succeeded | canceled
  confirmationUrl   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
}
