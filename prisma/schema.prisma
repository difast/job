generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── Справочники (профессии и вопросы живут в БД) ─────────

model ProfessionCategory {
  id          String       @id // slug, напр. "it"
  name        String
  sortOrder   Int          @default(0)
  professions Profession[]
}

model Profession {
  id           String             @id // slug, напр. "product-manager"
  name         String
  nameEn       String?
  categoryId   String
  category     ProfessionCategory @relation(fields: [categoryId], references: [id])
  description  String
  skills       String // JSON: string[] — типичные навыки
  requirements String // JSON: string[] — типичные требования
  sortOrder    Int                @default(0)
  active       Boolean            @default(true)

  levelProfiles ProfessionLevelProfile[]
  questions     InterviewQuestion[]
  users         User[]
}

// Junior / Middle / Senior / Lead профили профессии
model ProfessionLevelProfile {
  id           String     @id @default(cuid())
  professionId String
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
  level        String // junior | middle | senior | lead
  summary      String
  expectations String // JSON: string[]
  yearsFrom    Int        @default(0)
  yearsTo      Int?

  @@unique([professionId, level])
}

// Profession → Level → Interview Type → Question
// professionId = null  → вопрос подходит для любой профессии
// level        = null  → вопрос подходит для любого уровня
model InterviewQuestion {
  id           String      @id @default(cuid())
  professionId String?
  profession   Profession? @relation(fields: [professionId], references: [id], onDelete: Cascade)
  level        String?
  type         String // hr | professional | manager
  text         String
  category     String
  difficulty   Int         @default(2) // 1..3
  sampleAnswer String
  keyPoints    String // JSON: string[]
  sortOrder    Int         @default(0)

  attempts PracticeAttempt[]

  @@index([professionId, level, type])
}

// ───────── Пользователи ─────────

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  name            String
  passwordHash    String
  professionId    String?
  profession      Profession? @relation(fields: [professionId], references: [id])
  level           String?
  plan            String      @default("free") // free | pro
  planUntil       DateTime? // до какого момента оплачен pro
  pdConsentAt     DateTime? // когда дано согласие на обработку персональных данных (отдельная отметка при регистрации)
  pdConsentVer    String? // редакция документа согласия
  emailVerifiedAt DateTime? // когда e-mail подтверждён по ссылке из письма
  hasPassword     Boolean     @default(true) // false — аккаунт создан партнёром (JobToo), пароль ещё не задан
  source          String? // откуда пришёл пользователь: null — регистрация в Clymly, "jobtoo" — переход из JobToo
  // Маркетинговая атрибуция (src/lib/marketing): first-touch — первый визит по ссылке до регистрации,
  // last-touch — последний визит перед регистрацией. null — источник неизвестен.
  firstVisitId    String?
  signupVisitId   String?
  createdAt       DateTime    @default(now())

  sessions        Session[]
  resumes         Resume[]
  vacancies       Vacancy[]
  attempts        PracticeAttempt[]
  payments        Payment[]
  partnerLinks    PartnerLink[]
  emailTokens     EmailToken[]
  partnerConsents PartnerConsent[]
}

// Одноразовые ссылки из писем (подтверждение e-mail). Храним только sha256 токена.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String // verify
  email     String // адрес, который подтверждается
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Session {
  id        String   @id // sha256 токена
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now()) // время входа — для учёта активности

  @@index([userId, createdAt])
}

// ───────── Рабочие данные ─────────

model Resume {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  text         String
  analysis     String // JSON ResumeAnalysis
  professionId String // для какой профессии/уровня сделан анализ
  level        String
  analyzedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  adaptations Adaptation[]

  @@index([userId, createdAt])
}

model Vacancy {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  text       String
  analysis   String // JSON VacancyAnalysis
  matchScore Int
  resumeId   String?
  createdAt  DateTime @default(now())

  adaptation   Adaptation?
  coverLetters CoverLetter[]

  @@index([userId, createdAt])
}

model Adaptation {
  id        String   @id @default(cuid())
  vacancyId String   @unique
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  changes   String // JSON Change[] (id, original, adapted, reason, status, edited?)
  engine    String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model CoverLetter {
  id        String   @id @default(cuid())
  vacancyId String
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  style     String // professional | short | personal
  text      String
  engine    String
  createdAt DateTime @default(now())

  @@index([vacancyId, createdAt])
}

model PracticeAttempt {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String
  score      Int
  feedback   String // JSON AnswerFeedback
  createdAt  DateTime          @default(now())

  @@index([userId, questionId])
}

// ───────── Оплата (ЮKassa; пока работает тестовый провайдер-заглушка) ─────────

model Payment {
  // Заказ и платёж по нему (одна запись = один заказ на один тариф). id — номер заказа (у ЮMoney это label).
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // stub | yookassa | yoomoney
  providerPaymentId String?        @unique // id платежа у ЮKassa / operation_id у ЮMoney
  planId            String // стабильный id предложения: pro-month | pro-quarter
  planName          String? // название тарифа на момент покупки («Pro — 1 месяц»)
  months            Int? // срок на момент покупки, календарных месяцев
  amount            Int // фактическая сумма заказа, копейки (цена на момент покупки)
  currency          String         @default("RUB")
  status            String // статус платежа: pending | succeeded | canceled
  issue             String? // требует ручной проверки: amount_mismatch | currency_mismatch | duplicate_payment | paid_after_cancel | unaccepted | verify_failed
  confirmationUrl   String?
  paidAt            DateTime? // когда провайдер подтвердил оплату (дата обработки подтверждения)
  accessFrom        DateTime? // начало оплаченного этим заказом периода Pro
  accessUntil       DateTime? // конец оплаченного этим заказом периода Pro
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  events            PaymentEvent[]

  @@index([userId, createdAt])
  @@index([createdAt, status])
}

/// История статусов заказа: создание, переходы, отклонённые и повторные уведомления. Без секретов и данных карт.
model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status    String // pending | succeeded | canceled | rejected | duplicate | review
  source    String // checkout | provider | notification | sync | stub | return
  note      String?
  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
}

// ───────── Маркетинг: ссылки и визиты (атрибуция переход → регистрация → оплата) ─────────

// Маркетинговая ссылка: https://clymly.ru/go/<slug>. Метки по умолчанию дополняются UTM из ссылки.
model MarketingLink {
  id          String   @id @default(cuid())
  slug        String   @unique // instagram, reels-0310, blogger-anna …
  name        String
  target      String   @default("/") // только внутренний путь
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  visits Visit[]
}

// Переход по маркетинговой ссылке. Без IP и без отпечатка устройства; visitorId — случайный id из first-party cookie
// (90 дней, только если пользователь не отказался от аналитических cookie). userId — после регистрации или входа.
model Visit {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  linkId       String?
  link         MarketingLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  visitorId    String?
  userId       String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  referrerHost String?
  landing      String
  device       String? // desktop | mobile | tablet
  os           String?
  browser      String?
  lang         String?

  @@index([createdAt])
  @@index([linkId, createdAt])
  @@index([visitorId])
  @@index([userId, createdAt])
}

// ───────── Интеграции с партнёрами (JobToo) ─────────
// Формат обмена — docs/partner-api-v1.md. Персональные данные храним только там, где без них нельзя.

// Связка аккаунта Clymly с аккаунтом у партнёра
model PartnerLink {
  id                   String    @id @default(cuid())
  partner              String // jobtoo
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalUserId       String
  linkedAt             DateTime  @default(now())
  lastInboundRequestId String? // последний переход партнёр → Clymly (для события first_action)
  firstActionAt        DateTime?

  @@unique([partner, externalUserId])
  @@unique([partner, userId])
}

// Согласие пользователя Clymly на передачу данных партнёру (направление Clymly → партнёр)
model PartnerConsent {
  id         String    @id @default(cuid())
  partner    String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  acceptedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, partner])
}

// Журнал передач в обе стороны (без содержимого резюме). Для входящих — ещё и идемпотентность по requestId.
model PartnerHandoff {
  id             String   @id @default(cuid())
  partner        String
  direction      String // out — Clymly → партнёр; in — партнёр → Clymly
  requestId      String
  userId         String?
  externalUserId String?
  status         String // processing | ok | error
  account        String? // created | found | link_required
  errorCode      String?
  fields         String   @default("[]") // JSON: какие поля переданы
  placement      String?
  platform       String?
  durationMs     Int?
  result         String? // JSON ответа без ссылки входа (для повторов того же requestId)
  createdAt      DateTime @default(now())

  @@unique([partner, direction, requestId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// Данные, полученные от партнёра и ещё не применённые: нет профессии / ждём привязки аккаунта. Удаляются после применения.
model PartnerImport {
  id        String   @id @default(cuid())
  partner   String
  handoffId String
  userId    String?
  payload   String // JSON: имя, должность, уровень, текст резюме, вакансия
  createdAt DateTime @default(now())

  @@index([userId])
}

// Одноразовые коды: вход по ссылке (login), продолжение привязки (link). Храним только хеш.
model PartnerLoginCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  partner   String
  purpose   String // login | link
  userId    String?
  importId  String?
  requestId String
  next      String? // куда вести после входа
  expiresAt DateTime
  usedAt    DateTime?
}

// События аналитики переходов (без персональных данных, ссылок и кодов)
model IntegrationEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  partner       String
  direction     String // out | in
  event         String
  requestId     String?
  userId        String?
  partnerUserId String?
  placement     String?
  platform      String?
  account       String?
  errorCode     String?
  durationMs    Int?

  @@index([partner, createdAt])
  @@index([requestId])
}

// Очередь событий для отправки партнёру (POST /api/partner/v1/events), с повторами
model PartnerEventOutbox {
  id        String    @id @default(cuid())
  partner   String
  body      String // JSON одного события
  attempts  Int       @default(0)
  nextAt    DateTime  @default(now())
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sentAt, nextAt])
}
