# PostgreSQL 16+. Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/БАЗА?sslmode=require
DATABASE_URL="postgresql://gen_user:password@localhost:5432/default_db"
# Необязательно. Без ключа работает встроенный эвристический движок.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Оплата. По умолчанию — тестовая заглушка (деньги не списываются).
# Для ЮKassa: PAYMENT_PROVIDER=yookassa и ключи магазина; URL уведомлений: https://<домен>/api/billing/webhook
PAYMENT_PROVIDER=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — отправлять чек по 54-ФЗ (нужно, если в магазине включены чеки); код НДС ЮKassa
YOOKASSA_RECEIPT=
YOOKASSA_VAT_CODE=1

# ЮMoney — отдельный способ оплаты (форма Quickpay на кошелёк + HTTP-уведомления). Без этих переменных выключен.
# URL уведомлений в настройках кошелька (yoomoney.ru → Настройки → HTTP-уведомления): https://<домен>/api/billing/yoomoney
YOOMONEY_ENABLED=
# Номер кошелька-получателя (41001…)
YOOMONEY_WALLET=
# Секрет из настроек HTTP-уведомлений кошелька (проверка подписи sign)
YOOMONEY_NOTIFICATION_SECRET=
# Необязательно: OAuth-токен приложения ЮMoney с правом operation-details — доп. сверка операции через API
YOOMONEY_ACCESS_TOKEN=
# Основной публичный адрес: canonical, Open Graph, sitemap, возврат после оплаты
APP_URL=https://clymly.ru

# Интеграция с JobToo (формат обмена — docs/partner-api-v1.md). По умолчанию выключена.
JOBTOO_INTEGRATION_ENABLED=
# Единый адрес API JobToo (операции — ?op=pull|handoff|events) и домен ссылок входа JobToo
JOBTOO_API_URL=https://jobtoo.ru/api/partner.php
JOBTOO_LOGIN_ORIGIN=https://jobtoo.ru
# Секреты подписи (свой на каждое направление, генерация: openssl rand -hex 32):
# OUTBOUND — запросы Clymly → JobToo (pull, handoff, events); INBOUND — события JobToo → Clymly
JOBTOO_OUTBOUND_SECRET=
JOBTOO_INBOUND_SECRET=
# Письма (подтверждение e-mail). Порт 465 — SMTP с TLS. Без SMTP_HOST письма не отправляются, напоминание скрыто.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Clymly <no-reply@clymly.ru>"
# Куда приходят ответы на письма (по умолчанию — support@clymly.ru)
SMTP_REPLY_TO=
# E-mail администраторов (через запятую): отчёт /admin/integrations и выгрузка CSV
ADMIN_EMAILS=
