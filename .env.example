# PostgreSQL 16+. Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:5432/БАЗА?sslmode=require
DATABASE_URL="postgresql://gen_user:password@localhost:5432/default_db"
# ───── ИИ ─────
# AI_PROVIDER: gigachat | anthropic | none. Пусто — GigaChat, если задан GIGACHAT_AUTH_KEY, иначе Anthropic, если задан
# ANTHROPIC_API_KEY, иначе упрощённый режим без ИИ (правила на сервере). Если провайдер выбран явно, но не настроен,
# приложение запускается, а AI-функции возвращают понятную ошибку (диагностика — в логе при старте).
AI_PROVIDER=
# GigaChat API (developers.sber.ru). Ключ авторизации (Authorization key, Base64) из личного кабинета — без слова Basic.
GIGACHAT_AUTH_KEY=
# Область доступа: GIGACHAT_API_PERS (физлица), GIGACHAT_API_B2B (ИП/юрлица, пакеты), GIGACHAT_API_CORP (юрлица, оплата по факту)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: GigaChat-2 | GigaChat-2-Pro | GigaChat-2-Max
GIGACHAT_MODEL=GigaChat-2-Pro
# Корневой сертификат Минцифры (Russian Trusted Root CA, PEM): путь к файлу или содержимое. Можно вместо этого NODE_EXTRA_CA_CERTS.
GIGACHAT_CA_CERT=
# Необязательно: адреса API (по умолчанию https://api.giga.chat/v1 и https://ngw.devices.sberbank.ru:9443/api/v2/oauth)
GIGACHAT_API_URL=
GIGACHAT_AUTH_URL=
# Необязательно: таймаут запроса, мс (45000) и число повторов при 429/5xx/сетевых ошибках (2)
GIGACHAT_TIMEOUT_MS=
GIGACHAT_MAX_RETRIES=
# Необязательно, бета: 1 — передавать JSON-схему ответа (response_format), работает только на api.giga.chat
GIGACHAT_STRUCTURED_OUTPUT=
# Anthropic (Claude) — прежний провайдер, используется, только если выбран или не задан GigaChat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Оплата. По умолчанию — тестовая заглушка (деньги не списываются). Для ЮKassa: PAYMENT_PROVIDER=yookassa и ключи магазина.
# Уведомления (кабинет ЮKassa → Интеграция → HTTP-уведомления): https://<домен>/api/billing/yookassa,
# события payment.succeeded, payment.waiting_for_capture, payment.canceled, refund.succeeded.
PAYMENT_PROVIDER=
# shopId и секретный ключ (кабинет ЮKassa → Интеграция → Ключи API). Без них оплата через ЮKassa выключена.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Код НДС в чеке: 1 — без НДС, 2 — 0%, 3 — 10%, 4 — 20% (по умолчанию 1). Чеки 54-ФЗ передаются всегда.
YOOKASSA_VAT_CODE=1
# Система налогообложения (1 ОСН, 2 УСН доходы, 3 УСН доходы−расходы…) — только если в магазине их несколько
YOOKASSA_TAX_SYSTEM=
# 1 — принимать уведомления только с IP-адресов ЮKassa
YOOKASSA_IP_CHECK=
# Цены Pro, рубли (например 490 или 490.50). Без переменной — текущие 499 и 1190; неверное значение скрывает тариф.
PRO_MONTH_PRICE=
PRO_QUARTER_PRICE=
# Окно дневных напоминаний по Москве (по умолчанию 10-20)
REMINDER_HOURS=
# Основной публичный адрес: canonical, Open Graph, sitemap, возврат после оплаты (FRONTEND_URL — синоним)
APP_URL=https://clymly.ru

# Интеграция с JobToo (формат обмена — docs/partner-api-v1.md). По умолчанию выключена.
JOBTOO_INTEGRATION_ENABLED=
# Единый адрес API JobToo (операции — ?op=pull|handoff|events) и домен ссылок входа JobToo
JOBTOO_API_URL=https://jobtoo.ru/api/partner.php
JOBTOO_LOGIN_ORIGIN=https://jobtoo.ru
# Секреты подписи (свой на каждое направление, генерация: openssl rand -hex 32):
# OUTBOUND — запросы Clymly → JobToo (pull, handoff, events); INBOUND — события JobToo → Clymly
JOBTOO_OUTBOUND_SECRET=
JOBTOO_INBOUND_SECRET=
# Письма (подтверждение e-mail, восстановление и смена пароля, приветствие, оплата, окончание Pro — см. docs/emails.md).
# Порт 465 — SMTP с TLS. Без SMTP_HOST письма не отправляются, восстановление пароля по почте недоступно.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Clymly <no-reply@clymly.ru>"
# Куда приходят ответы на письма (по умолчанию — support@clymly.ru)
SMTP_REPLY_TO=
# E-mail администраторов (через запятую): отчёт /admin/integrations и выгрузка CSV
ADMIN_EMAILS=
